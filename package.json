{
  "name": "auspexlens",
  "displayName": "AuspexLens — SQL IDE & MCP for Oracle Database",
  "icon": "media/icon.png",
  "description": "Oracle Database client for VS Code: thin mode, no Instant Client, Autonomous Database wallets, schema explorer, PL/SQL, explain plans, and an embedded read-only MCP server.",
  "publisher": "lensql",
  "version": "1.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lensql/auspexlens-oss"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science"
  ],
  "pricing": "Free",
  "main": "./dist/extension.js",
  "private": true,
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node -e \"console.error('Do not package from inside the workspace: vsce follows npm\\\\'s hoisted node_modules and packages the whole monorepo. Use scripts/package-extension.sh.'); process.exit(1)\"",
    "shots": "node esbuild.integration.mjs && node out-integration/runShots.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "oracledb": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/oracledb": "^7.0.2",
    "@types/vscode": "1.102.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:plsql"
  ],
  "contributes": {
    "commands": [
      {
        "command": "auspexlens.connect",
        "title": "Connect",
        "category": "AuspexLens",
        "icon": "$(plug)"
      },
      {
        "command": "auspexlens.addConnection",
        "title": "Add a connection",
        "category": "AuspexLens",
        "icon": "$(add)"
      },
      {
        "command": "auspexlens.manageConnections",
        "title": "Manage connections",
        "category": "AuspexLens",
        "icon": "$(gear)"
      },
      {
        "command": "auspexlens.importWallet",
        "title": "Import wallet (.zip or folder)",
        "category": "AuspexLens",
        "icon": "$(key)"
      },
      {
        "command": "auspexlens.disconnect",
        "title": "Disconnect",
        "category": "AuspexLens",
        "enablement": "auspexlens.connected",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "auspexlens.toggleReadOnly",
        "title": "Toggle read-only",
        "category": "AuspexLens",
        "icon": "$(lock)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.togglePiiMasking",
        "title": "Toggle PII masking",
        "category": "AuspexLens",
        "icon": "$(eye)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.statusMenu",
        "title": "Status and toggles",
        "category": "AuspexLens",
        "icon": "$(gear)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.showContainer",
        "title": "Which container am I in?",
        "category": "AuspexLens",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.addRootConnection",
        "title": "Add a connection to the CDB root",
        "category": "AuspexLens",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.addPdbConnection",
        "title": "Add a connection to a pluggable database",
        "category": "AuspexLens",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.runQuery",
        "title": "Run query",
        "category": "AuspexLens",
        "icon": "$(play)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.cancelQuery",
        "title": "Cancel query",
        "category": "AuspexLens",
        "icon": "$(debug-stop)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.explainQuery",
        "title": "Explain plan",
        "category": "AuspexLens",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.findObject",
        "title": "Find database object",
        "category": "AuspexLens",
        "icon": "$(search)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.refreshExplorer",
        "title": "Refresh explorer",
        "category": "AuspexLens",
        "icon": "$(refresh)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.previewObject",
        "title": "Select the first 100 rows",
        "category": "AuspexLens",
        "icon": "$(table)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.copyName",
        "title": "Copy qualified name",
        "category": "AuspexLens",
        "icon": "$(copy)",
        "enablement": "auspexlens.connected"
      },
      {
        "command": "auspexlens.openSource",
        "title": "Open source",
        "category": "AuspexLens",
        "enablement": "auspexlens.connected",
        "icon": "$(code)"
      },
      {
        "command": "auspexlens.forgetCredentials",
        "title": "Forget stored credentials for a connection",
        "category": "AuspexLens"
      },
      {
        "command": "auspexlens.showDocs",
        "title": "Open documentation",
        "category": "AuspexLens"
      }
    ],
    "keybindings": [
      {
        "command": "auspexlens.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == sql || editorLangId == plsql)"
      },
      {
        "command": "auspexlens.cancelQuery",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && (editorLangId == sql || editorLangId == plsql)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "auspexlens.refreshExplorer",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "navigation@1"
        },
        {
          "command": "auspexlens.findObject",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "navigation@2"
        },
        {
          "command": "auspexlens.connect",
          "when": "view == auspexlens.explorer",
          "group": "1_connection@1"
        },
        {
          "command": "auspexlens.disconnect",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "1_connection@3"
        },
        {
          "command": "auspexlens.showContainer",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "2_container@1"
        },
        {
          "command": "auspexlens.addRootConnection",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "2_container@2"
        },
        {
          "command": "auspexlens.addPdbConnection",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "2_container@3"
        },
        {
          "command": "auspexlens.addConnection",
          "when": "view == auspexlens.explorer",
          "group": "navigation@3"
        },
        {
          "command": "auspexlens.manageConnections",
          "when": "view == auspexlens.explorer",
          "group": "1_connection@2"
        },
        {
          "command": "auspexlens.importWallet",
          "when": "view == auspexlens.explorer",
          "group": "1_connection@3"
        },
        {
          "command": "auspexlens.statusMenu",
          "when": "view == auspexlens.explorer && auspexlens.connected",
          "group": "3_state@1"
        }
      ],
      "editor/context": [
        {
          "command": "auspexlens.runQuery",
          "when": "editorLangId == sql || editorLangId == plsql",
          "group": "auspexlens@1"
        },
        {
          "command": "auspexlens.explainQuery",
          "when": "editorLangId == sql || editorLangId == plsql",
          "group": "auspexlens@2"
        },
        {
          "command": "auspexlens.cancelQuery",
          "when": "editorLangId == sql || editorLangId == plsql",
          "group": "auspexlens@3"
        }
      ],
      "commandPalette": [
        {
          "command": "auspexlens.disconnect",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.showContainer",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.addRootConnection",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.runQuery",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.explainQuery",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.findObject",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.openSource",
          "when": "false"
        },
        {
          "command": "auspexlens.refreshExplorer",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.previewObject",
          "when": "false"
        },
        {
          "command": "auspexlens.copyName",
          "when": "false"
        },
        {
          "command": "auspexlens.addPdbConnection",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.toggleReadOnly",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.togglePiiMasking",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.statusMenu",
          "when": "auspexlens.connected"
        },
        {
          "command": "auspexlens.cancelQuery",
          "when": "auspexlens.connected"
        }
      ],
      "view/item/context": [
        {
          "command": "auspexlens.previewObject",
          "when": "view == auspexlens.explorer && viewItem == object",
          "group": "inline"
        },
        {
          "command": "auspexlens.previewObject",
          "when": "view == auspexlens.explorer && viewItem == object",
          "group": "1_query@1"
        },
        {
          "command": "auspexlens.openSource",
          "when": "view == auspexlens.explorer && viewItem == object",
          "group": "1_query@2"
        },
        {
          "command": "auspexlens.copyName",
          "when": "view == auspexlens.explorer && viewItem =~ /^(schema|object|column)$/",
          "group": "2_clipboard"
        },
        {
          "command": "auspexlens.refreshExplorer",
          "when": "view == auspexlens.explorer && viewItem == schema",
          "group": "3_view"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "auspexlens",
          "title": "AuspexLens",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "auspexlens": [
        {
          "id": "auspexlens.explorer",
          "name": "Database",
          "contextualTitle": "AuspexLens"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "auspexlens.explorer",
        "contents": "No connection yet.\n[Add a connection](command:auspexlens.addConnection)\n[Import an Oracle wallet](command:auspexlens.importWallet)\nThe wizard asks for host, port, service and user, proposes Oracle’s default port, and tests the connection before saving anything. Your password goes to the OS keychain."
      }
    ],
    "configuration": {
      "title": "AuspexLens",
      "properties": {
        "auspexlens.readOnly.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Refuse any statement that is not read-only. Oracle's own SET TRANSACTION READ ONLY does not block DDL, TRUNCATE, DROP, GRANT or autonomous-transaction PL/SQL, so this guard is what stops them."
        },
        "auspexlens.pii.mode": {
          "type": "string",
          "enum": [
            "off",
            "named",
            "all"
          ],
          "default": "named",
          "description": "Mask personal data in the engine, before results reach the grid, an export, or the MCP server. 'named' masks columns whose name indicates personal data."
        },
        "auspexlens.results.maxRows": {
          "type": "number",
          "default": 5000,
          "description": "Maximum rows fetched for a single query."
        },
        "auspexlens.tls.rejectUnauthorized": {
          "type": "boolean",
          "default": true,
          "description": "Verify the database server's TLS certificate. This can only be true: AuspexLens connects in thin mode, where the Oracle driver always verifies and cannot be told not to. Setting it to false is refused with an explanation rather than ignored. To trust a private or self-signed CA, point NODE_EXTRA_CA_CERTS at its PEM file instead."
        },
        "auspexlens.connections.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Connection profiles. **Passwords and wallets are never stored here** — they go to your OS keychain through VS Code SecretStorage. See `AuspexLens: Connect`.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "user",
              "connectString",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier. No spaces or colons."
              },
              "label": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "connectString": {
                "type": "string",
                "description": "host:port/service, or a TNS alias when kind is 'wallet'."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "basic",
                  "wallet"
                ],
                "default": "basic"
              },
              "configDir": {
                "type": "string",
                "description": "Directory containing tnsnames.ora. Wallet profiles only."
              },
              "rejectUnauthorized": {
                "type": "boolean",
                "default": true,
                "description": "Verify the server's TLS certificate. Can only be true — thin mode always verifies. Use NODE_EXTRA_CA_CERTS to trust a private CA."
              }
            }
          }
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "auspexlens.mcp",
        "label": "AuspexLens (Oracle, read-only)"
      }
    ]
  },
  "keywords": [
    "oracle",
    "oracle database",
    "oracle client",
    "plsql",
    "sql",
    "explain plan",
    "schema browser",
    "autonomous database",
    "wallet",
    "mcp"
  ]
}
